# Variables del pipeline (Python). Copiá este archivo a `.env` y completalo; `.env` está en .gitignore.
# En GitHub Actions estos valores viven en Secrets, nunca en el repositorio.

# Proyecto de Supabase (https://<ref>.supabase.co)
SUPABASE_URL=
# Clave secreta (sb_secret_...): solo el pipeline. Nunca en la web, en Power BI ni en un commit.
SUPABASE_SECRET_KEY=
# Clave publicable (sb_publishable_...): solo para tests/test_rls.py, que prueba lo que ve un visitante.
SUPABASE_PUBLISHABLE_KEY=

# Fuentes con clave (opcionales). API-Basketball queda desactivada: el plan gratis no cubre 2026-27.
API_BASKETBALL_KEY=

# Ruta de revalidación de la web (8.9): la misma cadena larga en Vercel y en GitHub Secrets.
SITE_URL=
REVALIDATE_SECRET=
